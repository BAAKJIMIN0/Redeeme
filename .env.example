# docker-compose용 환경변수.

DB_PASSWORD=changeme

JWT_SECRET=changeme-replace-with-a-real-32byte-key

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 프론트/백엔드가 같은 도메인(EC2)을 사용할 경우 공백 (상대경로로 API 호출)
VITE_API_BASE_URL=

# 배포 도메인/IP. 여러 개면 콤마로 구분 (예: http://1.2.3.4,https://redeeme.example.com)
CORS_ALLOWED_ORIGINS=http://localhost
