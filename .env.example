# docker-compose용 환경변수. 복사해서 .env 로 저장하고 실제 값 채울 것 (.env는 git에 올리지 않음)

DB_PASSWORD=changeme

# HS256 이상 알고리즘은 256비트(32바이트) 이상 필요 - 아래 예시는 정확히 32자
JWT_SECRET=changeme-replace-with-a-real-32byte-key

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 프론트/백엔드를 같은 도메인(EC2)에서 서빙하면 비워두면 됨 (상대경로로 API 호출)
VITE_API_BASE_URL=

# 배포 도메인/IP. 여러 개면 콤마로 구분 (예: http://1.2.3.4,https://redeeme.example.com)
CORS_ALLOWED_ORIGINS=http://localhost
