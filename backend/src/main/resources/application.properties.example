spring.application.name=backend

# MySQL
# 아래 값들은 환경변수(DB_URL, DB_USERNAME, DB_PASSWORD)로 덮어쓸 수 있습니다.
spring.datasource.url=${DB_URL:jdbc:mysql://127.0.0.1:3306/redeeme?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:changeme}

# JPA
spring.jpa.hibernate.ddl-auto=update
# 로컬에서 SQL 로그를 보고 싶으면 JPA_SHOW_SQL=true 로 오버라이드
spring.jpa.show-sql=${JPA_SHOW_SQL:false}
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Google Client ID (for ID token verification)
# GOOGLE_CLIENT_ID는 Google Cloud Console에서 발급받은 값으로 설정
google.client-id=${GOOGLE_CLIENT_ID:your-google-client-id.apps.googleusercontent.com}

# JWT
# JWT_SECRET은 운영 환경에서 반드시 256비트 이상의 랜덤 값으로 교체할 것
jwt.secret=${JWT_SECRET:changeme-replace-with-a-real-32byte-key}
jwt.expiration=${JWT_EXPIRATION:604800000}

# CORS (콤마로 구분된 오리진 목록, 운영 도메인으로 교체할 것)
cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173}
